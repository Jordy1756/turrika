---
import StepCard from "@components/StepCard.astro";
---

<section id="steps">
    <h2>Manos a la obra</h2>
    <div>
        <StepCard index="1" description="Cortar el queso en cuadritos o tiras, según preferencia." />
        <StepCard index="2" description="Colocar el queso en una cacerola a fuego lento." />
        <StepCard index="3" description="Añadir la miel o el dulce elegido sobre el queso." />
        <StepCard index="4" description="Cocinar a fuego lento durante 30 minutos " />
        <StepCard index="5" description="Pinchar el queso para que absorba el dulce." />
        <StepCard index="6" description="Espolvorear canela al gusto, si se desea." />
        <StepCard index="7" description="Servir caliente o frío y disfrutar al gusto." />
    </div>
</section>

<style>
    section {
        position: relative;
        padding: 1rem;
        background-color: var(--neutral-900);
        display: flex;
        align-items: end;
        gap: 2rem;
        height: 100vh;
        overflow: hidden;
    }

    section > h2 {
        position: absolute;
        inset: 0;
        margin: auto;
        color: var(--primary-100);
        font-size: 250px;
        text-align: center;
        max-width: 6ch;
    }

    section > div {
        width: calc(500px * 7 + 150px * 6);
        display: flex;
        gap: 9.375rem;
        transform: translateY(calc(500px + 1rem));
    }
</style>

<script src="../scripts/handleSteps.ts"></script>

---
import NewsletterForm from "@components/NewsletterForm.astro";
import HeroIntroduction from "@components/HeroIntroduction.astro";
---

<section id="hero">
    <video width="100%" height="100dvh" preload="metadata" loop autoplay muted>
        <source src="https://res.cloudinary.com/dygwpgeq9/video/upload/v1748324746/intro_dflfq0.mp4" />
    </video>
    <article>
        <h2 id="hero-title-cheese" class="hero__title-cheese">Queso</h2>
        <h2 id="hero-title-pork-rinds" class="hero__title-pork-rinds">Chicharrones</h2>
        <NewsletterForm className="slide__in-left" />
    </article>
    <HeroIntroduction />

    <div class="corner__decoration top__left"></div>
    <div class="corner__decoration top__right"></div>
    <div class="corner__decoration bottom__left"></div>
    <div class="corner__decoration bottom__right"></div>
</section>

<style>
    section::before {
        content: "";
        position: absolute;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.6);
        z-index: 1;
    }

    section {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: end;
        width: 100%;
        height: 100dvh;
        padding: 1rem;
        overflow: hidden;
        z-index: 2;
    }

    section > video {
        position: absolute;
        inset: 0;
        height: 100%;
        object-fit: cover;
        z-index: -1;
    }

    section > article {
        align-self: center;
        padding: 1rem;
        width: min(var(--max-width), 100%);
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        grid-template-rows: repeat(2, 1fr) auto;
        grid-auto-columns: 1fr;
        grid-auto-flow: row;
        grid-template-areas:
            ". cheese . . . . . ."
            ". cheese . . form form form ."
            "pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds";
        gap: 1rem;
        place-items: center;
        z-index: 1;
    }

    section > article > .hero__title-pork-rinds {
        font-size: var(--text-hero-large);
        text-align: center;
        grid-area: pork-rinds;
        animation: slideInUp 0.5s ease-in-out;
        animation-delay: var(--slide-in-delay);
        z-index: 2;
    }

    section > article > .hero__title-cheese {
        writing-mode: sideways-lr;
        text-orientation: mixed;
        color: var(--primary-500);
        font-size: var(--text-hero-small);
        grid-area: cheese;
        animation: slideInRight 0.5s ease-in-out;
        animation-delay: var(--slide-in-delay);
        align-self: end;
    }

    .corner__decoration {
        position: absolute;
        width: 150px;
        aspect-ratio: 1;
        z-index: 3;
    }

    .corner__decoration.top__left {
        left: 2rem;
        top: 2rem;
        border-top: 1px solid var(--neutral-50);
        border-left: 1px solid var(--neutral-50);
        animation: slideInTopLeft 0.5s ease-in-out;
        animation-delay: var(--slide-in-delay);
    }

    .corner__decoration.top__right {
        right: 2rem;
        top: 2rem;
        border-top: 1px solid var(--neutral-50);
        border-right: 1px solid var(--neutral-50);
        animation: slideInTopRight 0.5s ease-in-out;
        animation-delay: var(--slide-in-delay);
    }

    .corner__decoration.bottom__left {
        left: 2rem;
        bottom: 2rem;
        border-bottom: 1px solid var(--neutral-50);
        border-left: 1px solid var(--neutral-50);
        animation: slideInBottomLeft 0.5s ease-in-out;
        animation-delay: var(--slide-in-delay);
    }

    .corner__decoration.bottom__right {
        right: 2rem;
        bottom: 2rem;
        border-bottom: 1px solid var(--neutral-50);
        border-right: 1px solid var(--neutral-50);
        animation: slideInBottomRight 0.5s ease-in-out;
        animation-delay: var(--slide-in-delay);
    }

    @media screen and (width <= 1024px) {
        section > article > .hero__title-pork-rinds {
            font-size: var(--text-hero-medium);
        }

        .corner__decoration {
            width: 75px;
        }
    }

    @media screen and (width <= 768px) {
        section > article {
            grid-template-areas:
                ". cheese . . . . . ."
                ". cheese . form form form form ."
                "pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds";
        }

        section > article > .hero__title-pork-rinds {
            font-size: var(--text-hero-small);
        }

        section > article > .hero__title-cheese {
            font-size: var(--text-display-medium);
        }

        .corner__decoration.top__left {
            left: 1rem;
            top: 1rem;
        }

        .corner__decoration.top__right {
            right: 1rem;
            top: 1rem;
        }

        .corner__decoration.bottom__left {
            left: 1rem;
            bottom: 1rem;
        }

        .corner__decoration.bottom__right {
            right: 1rem;
            bottom: 1rem;
        }
    }

    @media screen and (width <= 580px) {
        section > article {
            grid-template-rows: repeat(3, 1fr) auto;
            grid-template-areas:
                "pork-rinds . . . . . . ."
                "pork-rinds . . . . . . ."
                "pork-rinds form form form form form form form"
                "pork-rinds cheese cheese cheese cheese cheese cheese cheese";
            place-items: start;
        }

        section > article > .hero__title-pork-rinds {
            writing-mode: sideways-lr;
            text-orientation: mixed;
            font-size: var(--text-hero-large);
            margin-top: auto;
        }

        section > article > .hero__title-cheese {
            writing-mode: horizontal-tb;
            font-size: var(--text-hero-extra-large);
            margin-bottom: 1.5rem;
        }
    }

    @media screen and (width <= 480px) {
        section > article > .hero__title-pork-rinds {
            font-size: var(--text-hero-medium);
        }

        section > article > .hero__title-cheese {
            writing-mode: horizontal-tb;
            font-size: clamp(30px, 8vw + 1rem, 60px);
            margin-top: auto;
        }
    }

    @keyframes slideInRight {
        from {
            transform: translateX(-700px);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @keyframes slideInUp {
        from {
            transform: translateY(700px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @keyframes slideInTopLeft {
        from {
            transform: translate(-100%, -100%);
            opacity: 0;
        }
        to {
            transform: translate(0, 0);
            opacity: 1;
        }
    }

    @keyframes slideInTopRight {
        from {
            transform: translate(100%, -100%);
            opacity: 0;
        }
        to {
            transform: translate(0, 0);
            opacity: 1;
        }
    }

    @keyframes slideInBottomLeft {
        from {
            transform: translate(-100%, 100%);
            opacity: 0;
        }
        to {
            transform: translate(0, 0);
            opacity: 1;
        }
    }

    @keyframes slideInBottomRight {
        from {
            transform: translate(100%, 100%);
            opacity: 0;
        }
        to {
            transform: translate(0, 0);
            opacity: 1;
        }
    }
</style>

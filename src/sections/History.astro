<section class="history">
    <div>
        <p class="center reveal-title">Pasó de <span>abuela</span></p>
        <p class="start reveal-title">a <span>nieta</span></p>
        <p class="end reveal-title">entre risas</p>
        <p class="center reveal-title">y café</p>
        <p class="end reveal-title">una <span>joya local</span></p>
    </div>
</section>

<style>
    section {
        display: grid;
        place-items: center;
        width: 100%;
        min-height: 100dvh;
        padding: 1rem;
        overflow: hidden;
    }

    section > div {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    section > div > p {
        color: var(--neutral-50);
        line-height: 1.25;
        font-size: 128px;
        font-weight: 600;
        position: relative;
        white-space: nowrap;
    }

    section > div > p.start {
        text-align: start;
    }

    section > div > p.center {
        text-align: center;
    }

    section > div > p.end {
        text-align: end;
    }

    section > div > p > span {
        color: var(--primary-300);
    }
</style>

<script src="../scripts/handleHistory.ts"></script>

---
import CloseIcon from "@components/icons/Close.astro";
---

<header>
    <nav>
        <button command="show-modal" commandfor="nav-dialog">
            <span></span>
            <span></span>
        </button>
        <h1>Turríka</h1>
    </nav>
</header>

<dialog id="nav-dialog" closedby="any">
    <nav>
        <div>
            <button command="close" commandfor="nav-dialog">
                <CloseIcon width={24} />
            </button>
            <h1>Turríka</h1>
        </div>
        <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#ingredients">Ingredientes</a></li>
            <li><a href="#steps">Pasos</a></li>
        </ul>
    </nav>
</dialog>

<style>
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        padding: 4rem;
        animation: slideInDown var(--slide-in-delay) ease-in-out;
        z-index: 999;
    }

    header > nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
    }

    header > nav > button {
        display: flex;
        flex-direction: column;
        align-items: end;
        justify-content: center;
        gap: 0.5rem;
        width: 55px;
    }

    header > nav > button > span {
        height: 4px;
        background-color: var(--neutral-50);
    }

    header > nav > button > span:first-child {
        width: 66.6%;
    }

    header > nav > button > span:last-child {
        width: 100%;
    }

    header > nav > h1,
    dialog > nav > div > h1 {
        font-weight: 600;
        font-size: var(--text-display-extra-small);
    }

    dialog {
        top: 0;
        left: auto;
        right: 0;
        display: flex;
        min-height: 100dvh;
        color: var(--neutral-50);
        background-color: var(--dialog-background-color);
        backdrop-filter: var(--dialog-blur);
        transform: translateX(100%);
        transition:
            transform 0.5s ease-in-out,
            display 0.5s ease-in allow-discrete;
    }

    dialog[open] {
        transform: translateX(0);
    }

    dialog::backdrop {
        backdrop-filter: blur(4px);
    }

    dialog > nav {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
        padding: 4rem;
    }

    dialog > nav > div {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    dialog > nav > div > button {
        padding: 12px;
        display: grid;
        place-items: center;
        background-color: rgba(255, 255, 255, 0.1);
        aspect-ratio: 1;
        border-radius: 99999px;
    }

    dialog > nav > div > h1 {
        color: var(--primary-300);
    }

    dialog > nav > ul > li > a {
        font-size: var(--text-display-medium);
        font-weight: 500;
        text-transform: uppercase;
        transition: color 0.3s ease-in-out;
    }

    dialog > nav > ul > li > a:hover {
        color: var(--primary-100);
    }

    @starting-style {
        dialog[open] {
            transform: translateX(100%);
        }
    }

    @keyframes slideInDown {
        from {
            transform: translateY(-700px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>

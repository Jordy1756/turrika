---
import GithubIcon from "@components/icons/Github.astro";
import LinkedInIcon from "@components/icons/LinkedIn.astro";
import ResumeIcon from "@components/icons/Resume.astro";
// import NewsletterForm from "./NewsletterForm.astro";
---

<footer>
    <section class="main">
        <h2>Turríka</h2>
        <div>
            <!-- <NewsletterForm /> -->
            <nav>
                <div>
                    <h3>Receta</h3>
                    <ul>
                        <li>
                            <a href="#ingredients">Ingredientes</a>
                        </li>
                        <li>
                            <a href="#steps">Pasos</a>
                        </li>
                    </ul>
                </div>
                <div>
                    <h3>Legal</h3>
                    <ul>
                        <li>
                            <button type="button" class="open__privacy-modal">Política de privacidad</button>
                        </li>
                        <li>
                            <button type="button" class="open__terms-modal">Términos y condiciones</button>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
    </section>
    <div></div>
    <section class="social">
        <span>© 2025 Turríka. Todos los derechos reservados.</span>
        <nav>
            <ul>
                <li>
                    <a href="https://linkedin.com/in/yordicastro" target="_blank">
                        <LinkedInIcon width={24} height={24} color="var(--neutral-50)" />
                    </a>
                </li>
                <li>
                    <a href="https://jordy756-minimalist-portfolio.vercel.app/" target="_blank">
                        <ResumeIcon width={20} height={20} color="var(--neutral-50)" />
                    </a>
                </li>
                <li>
                    <a href="https://github.com/Jordy1756" target="_blank">
                        <GithubIcon width={24} height={24} color="var(--neutral-50)" />
                    </a>
                </li>
            </ul>
        </nav>
    </section>
    <aside>
        <span>Turríka</span>
    </aside>
</footer>

<style>
    footer {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8rem;
        padding: 3rem;
        min-height: 100dvh;
        background-color: var(--neutral-900);
        overflow: hidden;
        z-index: 1;
    }

    footer > .main {
        width: 100%;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        gap: 1rem;
    }

    .main > h2 {
        font-size: var(--text-hero-giant);
        color: var(--primary-100);
    }

    .main > div {
        width: 100%;
        display: flex;
        justify-content: space-between;
        gap: 2rem;
    }

    .main > div > nav {
        display: flex;
        gap: 5rem;
    }

    .main > div > nav > div,
    .main > div > nav > div > ul {
        display: flex;
        flex-direction: column;
    }

    .main > div > nav > div {
        gap: 1.5rem;
    }

    .main > div > nav > div > ul {
        gap: 0.5rem;
    }

    .main > div > nav > div > ul > li > button {
        background-color: transparent;
        border: none;
        text-transform: uppercase;
        text-align: start;
        color: var(--neutral-50);
        font-weight: 300;
    }

    footer > div {
        width: 100%;
        height: 1px;
        background-color: var(--neutral-50);
    }

    footer > .social {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
    }

    .social > nav > ul {
        display: flex;
        gap: 1rem;
    }

    .social > nav > ul > li {
        display: flex;
    }

    .social > nav > ul > li > a {
        display: flex;
        align-items: center;
    }

    aside {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-47%, -33%) rotate(-35deg);
        opacity: 0.1;
        z-index: -1;
    }

    aside > span {
        font-size: 31.25rem;
    }

    @media screen and (width <= 922px) {
        footer {
            padding: 1rem;
            gap: 4rem;
        }

        .main > h2 {
            font-size: var(--text-hero-large);
        }

        .main > div {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .main > div > nav {
            align-self: flex-end;
        }
    }

    @media screen and (width <= 632px) {
        .social {
            flex-direction: column;
        }

        .social > span {
            text-align: center;
        }
    }

    @media screen and (width <= 385px) {
        .main > div > nav {
            width: 100%;
            flex-direction: column;
            gap: 2rem;
        }
    }
</style>

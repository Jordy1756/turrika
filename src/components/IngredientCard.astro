---
import { Image } from "astro:assets";

type Props = {
    index: String;
    image: string;
    name: string;
    description: string;
    quantity: string;
};

const { index, image, name, description, quantity } = Astro.props;
---

<article>
    <aside>{index.padStart(2, "0")}</aside>
    <div>
        <header>
            <h3>{name}</h3>
            <h4>{quantity}</h4>
        </header>
        <section>
            <p>{description}</p>
            <figure>
                <Image src={image} alt="Queso" width={100} height={100} />
            </figure>
        </section>
    </div>
</article>

<style>
    article {
        display: flex;
        gap: 5rem;
        padding: 5rem;
        width: 100%;
        min-height: 100dvh;
        color: var(--neutral-50);
    }

    article > aside {
        padding-block: 1.5rem;
    }

    article > div {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    article > div > header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    article > div > header > h3 {
        font-size: var(--text-display-medium);
        color: var(--primary-100);
    }

    article > div > header > h4 {
        font-size: var(--text-heading-medium);
        font-weight: 400;
        opacity: 0.9;
    }

    article > div > section {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    article > div > section > p {
        font-size: var(--text-body-large);
    }

    article > div > section > figure {
        max-width: 600px;
        width: 100%;
        aspect-ratio: 1;
        display: flex;
        animation: moveDown 1s ease-in-out infinite alternate;
    }

    article > div > section > figure > img {
        width: 100%;
        height: 100%;
    }

    @media screen and (width <= 1200px) {
        article {
            padding: 5rem 1rem;
            gap: 1rem;
        }

        article > aside {
            padding-block: 1rem;
        }
    }

    @media screen and (width < 480px) {
        article > aside {
            padding-block: 0.5rem;
        }
    }

    @keyframes moveDown {
        from {
            transform: translateY(0);
        }
        to {
            transform: translateY(-5px);
        }
    }
</style>

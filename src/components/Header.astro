---
import CloseIcon from "@icons/CloseIcon.astro";

type Props = {
    className?: "slide__in-down";
};

const { className } = Astro.props;
---

<header id="header" class={className}>
    <nav>
        <div>
            <button type="button" id="close-navbar-btn">
                <CloseIcon width={24} height={25} color="var(--neutral-50)" />
            </button>
            <h1>Turríka</h1>
        </div>
        <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#ingredients">Ingredientes</a></li>
            <li><a href="#steps">Pasos</a></li>
        </ul>
    </nav>
    <div>
        <button type="button" id="open-navbar-btn">
            <span></span>
            <span></span>
        </button>
        <h1>Turríka</h1>
    </div>
    <div id="overlay" class="overlay"></div>
</header>

<style>
    header {
        position: fixed;
        top: 2rem;
        left: 2rem;
        width: calc(100% - 4rem);
        display: flex;
        justify-content: center;
        z-index: 999;
    }

    header.slide__in-down {
        animation: slideInDown 0.5s ease-in-out;
        animation-delay: var(--slide-in-delay);
    }

    header > nav {
        padding: 2rem;
        position: absolute;
        top: -2rem;
        right: -100%;
        height: 100dvh;
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(25px);
        display: flex;
        flex-direction: column;
        gap: 3rem;
        transition: right 0.3s ease-in-out;
        z-index: 1;
    }

    header.navbar__open > nav {
        right: -2rem;
    }

    header > nav > div {
        padding-block: 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    header > nav > div > button {
        width: 50px;
        height: 50px;
        background-color: transparent;
        border: none;
        display: grid;
        place-items: center;
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 99999px;
    }

    header > nav > div > h1 {
        color: var(--primary-300);
        font-weight: 700;
        font-size: 48px;
    }

    header > nav > ul {
        display: flex;
        flex-direction: column;
        gap: 5rem;
    }

    header > nav > ul > li {
        font-size: 64px;
        color: var(--neutral-50);
        transition: color 0.3s ease-in-out;
        font-weight: 500;
    }

    header > nav > ul > li > a:hover {
        color: var(--primary-100);
    }

    header > div {
        display: flex;
        align-items: center;
        justify-content: end;
        gap: 1rem;
        width: 100%;
        padding: 1rem;
    }

    header > div > button {
        display: flex;
        flex-direction: column;
        align-items: end;
        justify-content: center;
        gap: 0.75rem;
        width: 75px;
        background-color: transparent;
        border: none;
    }

    header > div > button > span {
        height: 2px;
        background-color: var(--neutral-50);
    }

    header > div > button > span:first-child {
        width: 75%;
    }

    header > div > button > span:last-child {
        width: 100%;
    }

    header > div > h1 {
        color: var(--neutral-50);
        font-weight: 700;
        font-size: 64px;
    }

    header > .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
    }

    header.navbar__open > .overlay {
        opacity: 1;
        pointer-events: visible;
    }

    @keyframes slideInDown {
        from {
            transform: translateY(-700px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>

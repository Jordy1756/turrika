---
import Input from "@components/Input.astro";
import Button from "@components/Button.astro";
import NewsLetterIcon from "@icons/NewsLetterIcon.astro";

type Props = {
    className?: "slide__in-left";
};

const { className } = Astro.props;
---

<section class={className}>
    <h4>Suscríbete para recibir recetas semanalmente</h4>
    <div>
        <form class="newsletter__form">
            <Input type="email" name="email" placeholder="Escribe tu email" />
            <Button type="submit" className="primary">
                <NewsLetterIcon width={24} height={24} color="var(--neutral-50)" />
            </Button>
        </form>
        <p>
            Al suscribirte, aceptas nuestra <button class="open__privacy-modal">Política de Privacidad</button> y das tu
            consentimiento para recibir actualizaciones de nuestra empresa.
        </p>
    </div>
</section>

<style>
    section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 400px;
        color: var(--neutral-50);
        grid-area: form;
    }

    section.slide__in-left {
        animation: slideInLeft 0.5s ease-in-out;
        animation-delay: var(--slide-in-delay);
    }

    section > div {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    section > h4 {
        font-size: clamp(14px, 0.6vw + 0.5rem, 24px);
    }

    section > div > form {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    section > div > p {
        font-size: var(--text-body-extra-small);
    }

    section > div > p > button {
        text-decoration: underline;
        text-transform: uppercase;
        border: none;
        background-color: transparent;
        color: var(--neutral-50);
        font-weight: 400;
    }

    @media screen and (width <= 580px) {
        section {
            margin-top: auto;
        }
    }

    @keyframes slideInLeft {
        from {
            transform: translateX(700px);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
</style>

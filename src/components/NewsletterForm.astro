---
import ArrowIcon from "@components/icons/Arrow.astro";
import Input from "@components/ui/Input.astro";
import Button from "@components/ui/Button.astro";

interface Props {
    className?: "slide__in-left";
}

const { className } = Astro.props;
---

<section class={className}>
    <h4>Suscríbete</h4>
    <div>
        <form class="newsletter__form">
            <Input id="email" label="Email" type="email" name="email" placeholder="Escribe tu email" />
            <Button>
                <ArrowIcon width={20} />
            </Button>
        </form>
        <p>
            Al suscribirte, aceptas nuestra <button class="open__privacy-modal">política de privacidad</button> y das tu consentimiento
            para recibir actualizaciones de nuestra empresa.
        </p>
    </div>
</section>

<style>
    section {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 400px;
        grid-area: form;
    }

    section.slide__in-left {
        animation: slideInLeft 0.5s ease-in-out;
        animation-delay: var(--slide-in-delay);
    }

    section > div {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    section > h4 {
        font-size: clamp(14px, 0.6vw + 0.5rem, 24px);
    }

    section > div > form {
        display: flex;
    }

    section > div > p {
        font-size: var(--text-body-extra-small);
    }

    section > div > p > button {
        text-decoration: underline;
        border: none;
        background-color: transparent;
        color: var(--neutral-50);
        font-weight: 400;
    }

    @media screen and (width <= 580px) {
        section {
            margin-top: auto;
        }
    }

    @keyframes slideInLeft {
        from {
            transform: translateX(700px);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
</style>

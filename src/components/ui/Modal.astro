---
import CloseIcon from "@components/icons/Close.astro";

interface Props {
    id: string;
    title: string;
}

const { id, title } = Astro.props;
---

<dialog id={id} closedby="any">
    <header>
        <h2>{title}</h2>
        <button type="button">
            <CloseIcon width={24} height={24} color="var(--neutral-900)" />
        </button>
    </header>
    <section>
        <slot />
    </section>
</dialog>

<style>
    dialog[open] {
        scale: 1;
    }

    dialog {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        border-radius: var(--border-radius-out);
        box-shadow: var(--box-shadow);
        border: none;
        scale: 0;
        background-color: var(--neutral-50);
        width: min(500px, 100%);
        transition:
            scale 0.3s ease-in-out,
            display 0.5s ease-in allow-discrete;
    }

    dialog > header {
        padding: 1rem 1rem 0.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    dialog > header > h2 {
        font-size: 24px;
        font-weight: 600;
    }

    dialog > header > button {
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1;
        background-color: transparent;
        border: none;
    }

    dialog > section {
        padding: 0.75rem 1rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    @starting-style {
        dialog[open] {
            scale: 0;
        }
    }
</style>

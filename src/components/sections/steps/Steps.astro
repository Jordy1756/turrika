---
import StepCard from "@components/sections/steps/StepCard.astro";
import { steps } from "@data";
---

<section id="steps">
    <h2>Manos a la obra</h2>
    <div>
        {steps.map((step, index) => <StepCard index={index + 1 + ""} description={step.description} />)}
    </div>
</section>

<style>
    section {
        position: relative;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 2rem;
        min-height: 100vh;
        overflow: clip;
        background-color: var(--neutral-900);
    }

    section > h2 {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: var(--primary-100);
        font-size: var(--text-hero-extra-large);
        text-align: center;
        max-width: 6ch;
        z-index: 1;
    }

    section > div {
        width: calc(500px * 7 + 150px * 6);
        display: flex;
        gap: 9.375rem;
        z-index: 2;
    }

    @media screen and (width <= 600px) {
        section > div {
            width: calc((100dvw - 2rem) * 7 + 64px * 7);
            gap: 4rem;
        }
    }
</style>

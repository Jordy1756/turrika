---
import NewsletterForm from "@components/sections/newsletter/NewsletterForm.astro";
import Corners from "@components/sections/hero/Corners.astro";
---

<section id="hero" class="hero">
    <video autoplay muted loop playsinline aria-hidden="true" tabindex="-1" poster="/hero_img.png">
        <source src="/video.mp4" />
    </video>
    <article>
        <h2 id="hero-title-cheese" class="hero__title-cheese">Queso</h2>
        <h2 id="hero-title-pork-rinds" class="hero__title-pork-rinds">Chicharrones</h2>
        <NewsletterForm />
    </article>
    <Corners />
</section>

<style>
    .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.5);
    }

    .hero {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: end;
        width: 100%;
        min-height: 100dvh;
        z-index: 1;
    }

    .hero > video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
    }

    .hero > article {
        align-self: center;
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        grid-template-rows: repeat(3, auto);
        grid-template-areas:
            ". cheese . . . . . ."
            ". cheese . . form form form ."
            "pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds pork-rinds";
        gap: 1rem;
        padding: 4rem;
        z-index: 1;
    }

    .hero > article > h2 {
        line-height: 1;
    }

    .hero > article > .hero__title-pork-rinds {
        grid-area: pork-rinds;
        font-size: var(--text-hero-large);
        text-align: center;
        animation: slideInUp var(--slide-in-delay) ease-in-out;
    }

    .hero > article > .hero__title-cheese {
        grid-area: cheese;
        writing-mode: sideways-lr;
        color: var(--primary-400);
        font-size: var(--text-hero-small);
        animation: slideInRight var(--slide-in-delay) ease-in-out;
    }

    /* @media screen and (width <= 1024px) {

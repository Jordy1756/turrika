---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Hero from "@sections/Hero.astro";
import History from "@sections/History.astro";
import Ingredients from "@sections/Ingredients.astro";
import Footer from "@components/Footer.astro";
import Steps from "@sections/Steps.astro";
---

<Layout title="Turríka">
    <Header className="slide__in-down" />
    <main>
        <Hero />
        <Ingredients />
        <Steps />
        <History />
    </main>
    <Footer />
    <script src="../scripts/main.ts"></script>
</Layout>

<style>
    main {
        background: url("/background.png") no-repeat center/cover fixed;
    }
</style>

{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@components/*": ["src/components/*"],
            "@layouts/*": ["src/layouts/*"],
            "@sections/*": ["src/sections/*"],
            "@utils/*": ["src/utils/*"],
            "@scripts/*": ["src/scripts/*"],
            "@constants/*": ["src/constants/*"]
        }
    }
}
